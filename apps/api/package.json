{
  "name": "@shiftly/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "election:record": "node src/cli/record-election.ts",
    "election:activate": "node src/cli/activate-election.ts",
    "reference:activate": "node src/cli/activate-reference.ts",
    "reference:research:contributions": "node src/cli/research-contributions.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --config ../../vitest.config.ts --project api"
