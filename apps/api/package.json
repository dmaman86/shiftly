  "dependencies": {
    "@google/genai": "^2.27.0",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "18.0.5",
    "express": "^5.3.0",
    "parse5": "^7.3.0",
    "unpdf": "1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shiftly/domain": "workspace:*",
    "@types/express": "^5.0.6"
  }
}
