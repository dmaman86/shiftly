{
  "name": "shiftly",
  "private": true,
  "version": "0.19.4",
  "homepage": "https://dmaman86.github.io/shiftly",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "bun run domain:build && vite apps/web --config apps/web/vite.config.ts",
    "dev:domain": "tsc -b packages/domain --watch",
    "domain:build": "tsc -b packages/domain --stopBuildOnErrors --pretty false",
    "typecheck": "tsc -b --stopBuildOnErrors --pretty false",
    "build": "tsc -b --stopBuildOnErrors --pretty false && vite build apps/web --config apps/web/vite.config.ts",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview apps/web --config apps/web/vite.config.ts",
    "calendar:generate": "node scripts/generate-calendar.ts",
    "test": "bun run domain:build && vitest",
    "test:ui": "bun run domain:build && vitest --ui",
    "test:domain": "bun run domain:build && vitest run --project domain",
    "test:web": "bun run domain:build && vitest run --project web",
    "test:coverage": "bun run domain:build && vitest run --coverage",
    "test:ci": "bun run domain:build && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui:august-2026": "PLAYWRIGHT_VIDEO=on playwright test e2e/desktop/work-table-month.spec.ts --project=desktop --grep \"\\(he\\)\" --output=test-results/august-2026",
    "test:e2e:ui:august-2026:mobile": "PLAYWRIGHT_VIDEO=on playwright test e2e/mobile/work-table-month.spec.ts --project=android --output=test-results/august-2026-mobile",
    "predeploy": "bun run typecheck && bun run lint && bun run test:ci && bun run build",
    "deploy": "gh-pages -d dist"
  },
  "overrides": {
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.0"
  }
}
